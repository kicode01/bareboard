{
  "name": "BareBoard",
  "short_name": "BareBoard",
  "description": "Offline 2D/3D PCB boardview viewer: inspect parts, pinouts, and trace nets in .brd, .brd2, .bdv, .bvr, .bvr3, .cad, .cst, .asc, and .zip files.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#111317",
  "theme_color": "#1a73e8",
  "categories": ["utilities", "productivity", "developer"],
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "./icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/octet-stream": [
          ".brd", ".bdv", ".bvr", ".cad", ".cst", ".asc", ".bom", ".fz", ".cae", ".tvw", ".bv", ".gr", ".f2b"
        ]
      }
    }
  ],
  "shortcuts": [
    { "name": "Open boardview file", "short_name": "Open", "url": "./?action=open" }
  ]
}
