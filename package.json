{
  "name": "bareboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Offline-capable 2D CAD, 2D Realistic, and interactive 3D PCB boardview viewer PWA.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
